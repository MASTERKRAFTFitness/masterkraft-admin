# ─── HOME project ────────────────────────────────────────────────────────────
# Holds staff identity (auth.users + staff_members). Sessions live here, so RLS
# is a real boundary for this project. Run supabase/migrations/0001_staff.sql
# against THIS project.
NEXT_PUBLIC_SUPABASE_URL=https://<home-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── ADMINISTERED projects ───────────────────────────────────────────────────
# Reached server-side with service-role keys, which BYPASS RLS. Access is gated
# by requireStaff() in src/lib/supabase/admin.ts — there is no database-level
# safety net here, so never import these clients into a client component.
PORTALS_SUPABASE_URL=https://yvalgutmowcvhrnpsbob.supabase.co
PORTALS_SERVICE_ROLE_KEY=

CATALOGUES_SUPABASE_URL=https://pmydkwszkgjnolrcnenh.supabase.co
CATALOGUES_SERVICE_ROLE_KEY=

# CRM — not yet migrated. Add when it lands; see src/lib/supabase/projects.ts.
# CRM_SUPABASE_URL=
# CRM_SERVICE_ROLE_KEY=
